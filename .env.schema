# @defaultSensitive=true @defaultRequired=true
# ---
# Read only by notify_ready() in airship.py, through
# `varlock run --path <airship dir>`. With no .env.local, airship skips the
# push notification; once .env.local exists, both keys are required.

# Pushover application token for airship (pushover.net → Create an Application).
# @type=string
PUSHOVER_TOKEN=

# Pushover user key (the recipient; always Trey).
# @type=string
PUSHOVER_USER=

# Base URL of the Pushover-compatible API. Unset: https://api.pushover.net.
# squillo on the Studio: http://127.0.0.1:4580
# @optional @type=url
PUSHOVER_BASE_URL=
