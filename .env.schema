# @defaultSensitive=true @defaultRequired=true
# Secrets come from the "airship" item (and "pushover-user" for PUSHOVER_USER) in the self-hosted Vaultwarden
# (see ~/dev/vw-tools).
# @plugin(@varlock/bitwarden-plugin@2.0.2)
# @initBwp(sessionToken=$BW_SESSION_TOKEN, appDataDir=$BWP_APPDATA_DIR)
# Memory only: the default disk cache waits for Touch ID, which hangs launchd starts.
# @cache=memory
# ---

# bw CLI data dir for the Vaultwarden "machines" account (set up with vw-login).
# @sensitive=false @internal
BWP_APPDATA_DIR=~/.config/bw-machines

# Long-lived bw session from the login keychain (stored by vw-login, refreshed by vw-sync).
# Plain `security`, not keychain(), so launchd can start the server without Touch ID.
# @internal
BW_SESSION_TOKEN=exec("/usr/bin/security find-generic-password -s varlock-bwp -a machines-session -w")

# Read only by notify_ready() in airship.py, through
# `varlock run --path <airship dir>`. With no .env.local, airship skips the
# push notification; once .env.local exists, both keys are required.

# Pushover application token for airship (pushover.net → Create an Application).
# @type=string
PUSHOVER_TOKEN=bwp("airship", field=PUSHOVER_TOKEN)

# Pushover user key (the recipient; always Trey).
# @type=string
PUSHOVER_USER=bwp("pushover-user", field=PUSHOVER_USER)

# Base URL of the Pushover-compatible API. Unset: https://api.pushover.net.
# Set it to send through a self-hosted Pushover-compatible server.
# @optional @sensitive=false @type=url
PUSHOVER_BASE_URL=
